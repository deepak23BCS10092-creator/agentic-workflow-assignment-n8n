    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst validated = [];\n\nfor (const item of items) {\n  const data = item.json.output || item.json;\n  \n  const hasTitle = data.title && typeof data.title === \"string\";\n  const hasSummary = data.summary && typeof data.summary === \"string\";\n  const hasUrgency = typeof data.urgency === \"number\" && data.urgency >= 1 && data.urgency <= 10;\n  const hasActions = Array.isArray(data.actionItems) && data.actionItems.length > 0;\n  \n  validated.push({\n    json: {\n      ...data,\n      valid: hasTitle && hasSummary && hasUrgency && hasActions,\n      validationErrors: [\n        !hasTitle ? \"Missing or invalid title\" : null,\n        !hasSummary ? \"Missing or invalid summary\" : null,\n        !hasUrgency ? \"Missing or invalid urgency (1-10)\" : null,\n        !hasActions ? \"Missing or empty actionItems array\" : null\n      ].filter(e => e !== null)\n    }\n  });\n}\n\nreturn validated;"
      },
      "id": "2c739b95-0b86-46d8-a390-018fecd53ac9",
